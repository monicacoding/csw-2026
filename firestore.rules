rules_version = '2';

// ---------------------------------------------------------------------------
// Intentionally open rules, scoped to only the collections this app uses.
// There is no real authentication here (see README.md) — this is a
// low-friction internal tool for one fun week, not a security boundary.
// Paste into Firebase Console → Firestore → Rules, or deploy with:
//   firebase deploy --only firestore:rules
//
// IMPORTANT — `allow read` is NOT one rule, it's shorthand for two:
// `get` (fetching one document by ID, e.g. FirestoreDB.getDoc) and `list`
// (querying a whole collection, e.g. FirestoreDB.listCollection — every
// leaderboard, the Photo Finish Gallery, the Recognition Wall all go
// through this). A condition written against the path wildcard (`code` in
// `match /users/{code}`) only has a real value for `get` — a `list`
// request targets the collection, not one document, so `code` is unbound
// during list evaluation and any condition touching it denies the whole
// query. That silently broke every list read in this app (confirmed live:
// a GET on a known doc returned 200, a LIST on the same collection
// returned 403 PERMISSION_DENIED) while every single-document get/write
// kept working fine — which is why writes always "succeeded" but nothing
// ever showed back up in a leaderboard/gallery/wall. `get`/`write` keep
// the doc-ID format check (little real value since this isn't a security
// boundary anyway, but cheap to keep); `list` is opened unconditionally,
// consistent with this file's own stated non-security posture.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{code} {
      allow get, write: if code.matches('^[A-Z]{4}$');
      allow list: if true;
    }

    match /hyperlinkRaceEntries/{code} {
      allow get, write: if code.matches('^[A-Z]{4}$');
      allow list: if true;
    }

    // The Hyperlink Race anti-sharing mechanism: the word assigned to each
    // user on the goal page (Store.assignHyperlinkAnswer/getHyperlinkAssignment
    // — see js/store.js). Separate from hyperlinkRaceEntries above since
    // it's written mid-session (on reaching the goal page), before the
    // actual submission happens.
    match /hyperlinkRaceProgress/{code} {
      allow get, write: if code.matches('^[A-Z]{4}$');
      allow list: if true;
    }

    match /snapJudgementEntries/{code} {
      allow get, write: if code.matches('^[A-Z]{4}$');
      allow list: if true;
    }

    match /triviaEntries/{code} {
      allow get, write: if code.matches('^[A-Z]{4}$');
      allow list: if true;

      // Race Day Trivia runs daily now — each day's 5-question set is its
      // own doc in this subcollection (triviaEntries/{code}/days/{dayId} —
      // see Store.submitTriviaDay in js/store.js) rather than one flat doc
      // per user, so it needs its own match block here. A rule on the
      // parent /triviaEntries/{code} document does not implicitly cover
      // its subcollections.
      match /days/{dayId} {
        allow get, write: if code.matches('^[A-Z]{4}$');
        allow list: if true;
      }
    }

    match /photoFinishEntries/{code} {
      allow get, write: if code.matches('^[A-Z]{4}$');
      allow list: if true;

      match /votes/{voterCode} {
        allow get, write: if voterCode.matches('^[A-Z]{4}$');
        allow list: if true;
      }
    }

    match /nominations/{code} {
      allow get, write: if code.matches('^[A-Z]{4}$');
      allow list: if true;
    }

    match /minigameEntries/{code} {
      allow get, write: if code.matches('^[A-Z]{4}$');
      allow list: if true;
    }

    // Everything else stays locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
